# Production Environment Configuration for vLLM on AWS EC2 (g6e.2xlarge / g6e.4xlarge)

# Model Settings
MODEL_ID=Qwen/Qwen3.8-27B-FP8
SERVED_MODEL_NAME=qwen3.8-27b
MAX_MODEL_LEN=16384
MAX_NUM_BATCHED_TOKENS=4192
MAX_NUM_SEQS=16
GPU_MEMORY_UTILIZATION=0.85
KV_CACHE_DTYPE=fp8
TENSOR_PARALLEL_SIZE=1

# Server Settings
HOST_PORT=8000
CONTAINER_PORT=8000

# Storage Paths on Host (EBS volume)
CACHE_DIR=~/.cache/huggingface

# Optional Hugging Face Token (to avoid unauthenticated rate limits)
HF_TOKEN=
