# Production Environment Configuration for vLLM on AWS EC2 (g6e.2xlarge)

# Model Settings
MODEL_ID=Qwen/Qwen3-Coder-30B-A3B-Instruct-FP8
SERVED_MODEL_NAME=qwen3-coder-30b
MAX_MODEL_LEN=32768
MAX_NUM_BATCHED_TOKENS=2048
GPU_MEMORY_UTILIZATION=0.92
KV_CACHE_DTYPE=fp8
TENSOR_PARALLEL_SIZE=1

# Server Settings
HOST_PORT=8000
CONTAINER_PORT=8000

# Storage Paths on EC2 Host
# Point to persistent EBS mount directory
CACHE_DIR=/data/model-cache

# Optional Hugging Face Token (required only for gated models)
HF_TOKEN=
